#!/usr/bin/env bash
# Install buildkite-test-collector from buildkite/bktest at a pinned commit into
# the example directory this runs from, the way a customer would upgrade.
#   sdk2: keep the example's OpenTelemetry packages unchanged.
#   sdk3: replace them with the SDK 3 set from the collector's docs.
# Extra arguments are added as more devDependencies.
set -euo pipefail

SHA="${1:?usage: use-unreleased-js-collector <bktest sha> <sdk2|sdk3> [package specs...]}"
LINE="${2:?usage: use-unreleased-js-collector <bktest sha> <sdk2|sdk3> [package specs...]}"
shift 2

WORKDIR="$(mktemp -d)"
git -C "${WORKDIR}" init -q
git -C "${WORKDIR}" fetch -q --depth 1 https://github.com/buildkite/bktest.git "${SHA}"
git -C "${WORKDIR}" checkout -q FETCH_HEAD
TARBALL="$(cd "${WORKDIR}/test-collector-javascript" && npm pack --silent --pack-destination "${WORKDIR}")"

specs=("buildkite-test-collector@file:${WORKDIR}/${TARBALL}")
case "${LINE}" in
  sdk2) ;;
  sdk3)
    for name in $(node -p 'Object.keys(require("./package.json").devDependencies).filter((name) => name.startsWith("@opentelemetry/")).join(" ")'); do
      npm pkg delete "devDependencies.${name}"
    done
    specs+=(
      '@opentelemetry/api@^1.10'
      '@opentelemetry/sdk-trace@^3'
      '@opentelemetry/context-async-hooks@^3'
      '@opentelemetry/exporter-trace-otlp-proto@~0.301.0'
    )
    ;;
  *) echo "unknown SDK line: ${LINE}" >&2; exit 2 ;;
esac

rm -f package-lock.json
npm install --save-dev --strict-peer-deps "${specs[@]}" "$@"
npm ls --depth 0
