#!/usr/bin/env bash
# Install the unreleased JavaScript collector from buildkite/bktest at a pinned
# commit into the example directory this is run from. The example's
# package.json declares the OpenTelemetry packages.
set -euo pipefail

SHA="${1:?usage: install-unreleased-js-collector <bktest commit sha>}"
WORKDIR="$(mktemp -d)"

git -C "${WORKDIR}" init -q
git -C "${WORKDIR}" fetch -q --depth 1 https://github.com/buildkite/bktest.git "${SHA}"
git -C "${WORKDIR}" checkout -q FETCH_HEAD

TARBALL="$(cd "${WORKDIR}/test-collector-javascript" && npm pack --silent)"
npm install --no-save "${WORKDIR}/test-collector-javascript/${TARBALL}"

echo "buildkite-test-collector $(node -p 'require("buildkite-test-collector/package.json").version') from bktest ${SHA:0:8}"
