+/**
+ * Whether an application import names a module by absolute path or file URL,
+ * excluding the entrypoint, `require()` and import-in-the-middle's own wrappers.
+ *
+ * @param {string} specifier The original import specifier.
+ * @param {ResolveContext} context The resolve context.
+ */
+function isAbsoluteImport (specifier, context) {
+  const { parentURL = '' } = context
+  return (specifier.startsWith('/') || specifier.startsWith('file:')) &&
+    parentURL !== '' && !hasIitm(parentURL) && !hasIitm(specifier) &&
+    context.conditions?.includes('require') !== true
+}
+
+/**
+ * Test runners such as Vitest import a package's entry point by the path they
+ * resolved for it, not by package name. When importing the package by name
+ * would resolve to the same URL, return that name, so the import matches
+ * `include`/`exclude` entries and `Hook` package names like `import 'pkg'`.
+ * require-in-the-middle treats `require()` of a package's main file the same way.
+ *
+ * @param {string} url The resolved module URL.
+ * @param {ResolveContext} context The resolve context.
+ * @returns {Generator<Array, string | undefined>}
+ */
+function * packageEntryName (url, context) {
+  const index = url.lastIndexOf('/node_modules/')
+  if (index === -1 || !url.startsWith('file:')) return
+  const start = index + '/node_modules/'.length
+  const [first, second] = url.slice(start).split('/', 2)
+  const name = first.startsWith('@') ? `${first}/${second}` : first
+  try {
+    const entry = yield [RESOLVE, name, { ...context, parentURL: `${url.slice(0, start)}${name}/package.json` }]
+    if (entry.url === url) return name
+  } catch {}
+}
