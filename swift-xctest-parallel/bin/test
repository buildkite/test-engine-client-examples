#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ $# -eq 0 ]]; then
  echo 'No selectors assigned; running no tests.'
  exit 0
fi
filters=()
for selector in "$@"; do
  echo "Assigned selector: $selector"
  # Expand only methods enabled at discovery; never broaden TEST_FILTER/SKIP.
  while IFS= read -r method; do
    escaped="${method//./\\.}"
    filters+=(--filter "^${escaped}$")
  done < <(awk -F/ -v selector="$selector" '$0 == selector || $1 == selector' artifacts/methods.txt)
done
if [[ ${#filters[@]} -eq 0 ]]; then
  echo 'No enabled methods assigned; running no tests.'
  exit 0
fi
swift test --skip-build --disable-swift-testing "${filters[@]}"
