# frozen_string_literal: true

source "https://rubygems.org"

gem "rspec", "~> 3.13"

gem "buildkite-test_collector",
  git: "https://github.com/buildkite/bktest.git",
  ref: "test-collector-ruby/v2.15.0",
  glob: "test-collector-ruby/*.gemspec"

# The collector configures the OpenTelemetry SDK and installs these
# instrumentations, but applications must provide them.
gem "opentelemetry-exporter-otlp", "~> 0.34"
gem "opentelemetry-instrumentation-active_record", "~> 0.13"
gem "opentelemetry-instrumentation-net_http", "~> 0.29"
gem "opentelemetry-instrumentation-redis", "~> 0.29"
gem "opentelemetry-sdk", "~> 1.13"

# Used by the example specs to produce HTTP, SQL, and Redis spans.
gem "activerecord", "~> 8.0"
gem "redis", "~> 5.0"
gem "sqlite3", "~> 2.0"
