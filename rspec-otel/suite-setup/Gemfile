# frozen_string_literal: true

source "https://rubygems.org"

gem "rspec", "~> 3.13"

# OpenTelemetry support is not released yet, so pin the collector commit used by
# buildkite/buildkite#32473.
gem "buildkite-test_collector",
  github: "buildkite/test-collector-ruby",
  ref: "68c2d04b4ab7c170daa10b3b99dafd256f29caba"

# This suite owns its OpenTelemetry SDK and explicitly selected instrumentations.
gem "opentelemetry-instrumentation-active_record", "~> 0.13"
gem "opentelemetry-instrumentation-net_http", "~> 0.29"
gem "opentelemetry-sdk", "~> 1.13"

# Used by the example specs to perform HTTP, SQL, and Redis operations.
gem "activerecord", "~> 8.0"
gem "redis", "~> 5.0"
gem "sqlite3", "~> 2.0"
