# frozen_string_literal: true

# Control Gemfile for the test-collector-go OTel verification: the released
# Ruby collector 2.17.0 in OTel-only mode, run directly (no bktec), so a Test
# Engine run appearing here proves OIDC, the org flag and ingestion before the
# Go collector is blamed for anything.
source "https://rubygems.org"

gem "rspec", "~> 3.13"

gem "buildkite-test_collector", "2.17.0"
gem "opentelemetry-exporter-otlp", "~> 0.34", require: false
gem "opentelemetry-sdk", "~> 1.13", require: false
