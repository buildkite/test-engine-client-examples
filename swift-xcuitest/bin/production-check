#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/../.."

# This queue has a recent image; fail rather than silently test Xcode 15 again.
export DEVELOPER_DIR=/Applications/Xcode_26.2.app/Contents/Developer
mkdir -p swift-xcuitest/artifacts
{
  date -u
  sw_vers
  xcodebuild -version
  xcrun simctl list devices available
  printf 'Queue: %s\n' "${BUILDKITE_AGENT_META_DATA_QUEUE:-unknown}"
} | tee swift-xcuitest/artifacts/environment.txt

export BUILDKITE_ANALYTICS_KEY="${BUILDKITE_BUILD_ID}-${ARLO_SCENARIO}-${BUILDKITE_JOB_ID}"
export BUILDKITE_ANALYTICS_DEBUG_ENABLED=true
unset BUILDKITE_ANALYTICS_TOKEN BUILDKITE_TEST_ENGINE_API_ACCESS_TOKEN

if [[ "$ARLO_SCENARIO" == direct ]]; then
  # Never echo the token. The secret must be provisioned by Matt in Buildkite.
  export BUILDKITE_ANALYTICS_TOKEN="$(buildkite-agent secret get "$ARLO_SUITE_TOKEN_SECRET")"
  export BUILDKITE_ORGANIZATION_SLUG="${ARLO_REFUSED_ORG:?}"
  export BUILDKITE_TEST_ENGINE_SUITE_SLUG="${ARLO_REFUSED_SUITE:?}"
  unset BUILDKITE_TESTS_OTLP_TOKEN OTEL_EXPORTER_OTLP_TRACES_HEADERS OTEL_EXPORTER_OTLP_TRACES_ENDPOINT
fi

if [[ "$ARLO_SCENARIO" == fast ]]; then
  bash swift-xctest/bin/prepare-merge-demo
  # Compile once; both timed commands run the same built suite.
  BUILDKITE_ANALYTICS_ENABLED=false /usr/bin/time -p swift test --package-path swift-xctest/artifacts/merge-suite --skip-build --disable-swift-testing \
    2>&1 | tee swift-xcuitest/artifacts/disabled.log
  "$BUILDKITE_TEST_ENGINE_CLIENT_PATH" --version
  /usr/bin/time -p "$BUILDKITE_TEST_ENGINE_CLIENT_PATH" run 2>&1 | tee swift-xcuitest/artifacts/relay.log
  exit 0
fi

# Baseline first on the same agent/simulator; compile separately from test timing.
xcodebuild -project swift-xcuitest/SwiftXCUITest.xcodeproj -scheme SwiftXCUITest \
  -resolvePackageDependencies 2>&1 | tee swift-xcuitest/artifacts/resolve.log
export BUILDKITE_ANALYTICS_ENABLED=false
export XCUITEST_ARTIFACTS_DIR="$PWD/swift-xcuitest/artifacts/disabled"
export XCUITEST_RUN_ID="$BUILDKITE_ANALYTICS_KEY-disabled"
/usr/bin/time -p bash swift-xcuitest/bin/test 2>&1 | tee swift-xcuitest/artifacts/disabled.log

export BUILDKITE_ANALYTICS_ENABLED=true
export XCUITEST_ARTIFACTS_DIR="$PWD/swift-xcuitest/artifacts/enabled"
export XCUITEST_RUN_ID="$BUILDKITE_ANALYTICS_KEY-enabled"
if [[ "$ARLO_SCENARIO" == direct ]]; then
  /usr/bin/time -p bash swift-xcuitest/bin/test 2>&1 | tee swift-xcuitest/artifacts/direct.log
else
  "$BUILDKITE_TEST_ENGINE_CLIENT_PATH" --version
  /usr/bin/time -p "$BUILDKITE_TEST_ENGINE_CLIENT_PATH" run 2>&1 | tee swift-xcuitest/artifacts/relay.log
fi
