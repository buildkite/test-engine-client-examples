#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."
[[ $# -gt 0 ]] || exit 0

for name in BUILDKITE_ANALYTICS_OTLP_ENDPOINT BUILDKITE_TESTS_OTLP_TOKEN \
  BUILDKITE_{AGENT_ID,BRANCH,BUILD_ID,BUILD_NUMBER,BUILD_URL,COMMIT,JOB_ID,MESSAGE,STEP_ID} \
  BUILDKITE_ORGANIZATION_SLUG BUILDKITE_TEST_ENGINE_SUITE_SLUG TRACEPARENT TRACESTATE; do
  if [[ -n "${!name:-}" ]]; then
    export "TEST_RUNNER_${name}=${!name}"
  fi
done

# Class filters can re-enable methods excluded by the test plan.
methods="$(jq -r --args '
  .values[].enabledTests[].identifier |
  select((split("/")[0:2] | join("/")) as $class | $ARGS.positional | index($class))
' "$@" < artifacts/enumeration.json)"
: "${methods:?No enabled tests match the assigned classes}"
only_testing=()
while IFS= read -r method; do
  only_testing+=("-only-testing:$method")
done <<< "$methods"

rm -rf artifacts/results.xcresult
xcodebuild test-without-building \
  -xctestrun artifacts/Products/Tests.xctestrun \
  -destination "${XCUITEST_DESTINATION:-platform=iOS Simulator,name=iPhone 17}" \
  -resultBundlePath artifacts/results.xcresult \
  -parallel-testing-enabled NO "${only_testing[@]}"
