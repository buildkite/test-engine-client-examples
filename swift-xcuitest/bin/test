#!/bin/bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
artifacts_dir="${XCUITEST_ARTIFACTS_DIR:-$root/artifacts}"
result_bundle="$artifacts_dir/SwiftXCUITest.xcresult"
test_log="$artifacts_dir/xcodebuild.log"

for name in \
  BUILDKITE_ANALYTICS_KEY \
  BUILDKITE_ANALYTICS_BRANCH \
  BUILDKITE_ANALYTICS_DEBUG_ENABLED \
  BUILDKITE_ANALYTICS_ENABLED \
  BUILDKITE_ANALYTICS_ENVIRONMENT \
  BUILDKITE_ANALYTICS_EXECUTION_NAME_PREFIX \
  BUILDKITE_ANALYTICS_EXECUTION_NAME_SUFFIX \
  BUILDKITE_ANALYTICS_JOB_ID \
  BUILDKITE_ANALYTICS_MESSAGE \
  BUILDKITE_ANALYTICS_NUMBER \
  BUILDKITE_ANALYTICS_OTLP_ENDPOINT \
  BUILDKITE_ANALYTICS_SHA \
  BUILDKITE_ANALYTICS_TAGS \
  BUILDKITE_ANALYTICS_TOKEN \
  BUILDKITE_ANALYTICS_URL \
  BUILDKITE_BRANCH \
  BUILDKITE_BUILD_ID \
  BUILDKITE_BUILD_NUMBER \
  BUILDKITE_BUILD_URL \
  BUILDKITE_COMMIT \
  BUILDKITE_JOB_ID \
  BUILDKITE_MESSAGE \
  BUILDKITE_ORGANIZATION_SLUG \
  BUILDKITE_STEP_ID \
  BUILDKITE_TAG \
  BUILDKITE_TEST_ENGINE_SUITE_SLUG \
  BUILDKITE_TESTS_OTLP_TOKEN \
  OTEL_EXPORTER_OTLP_TRACES_ENDPOINT \
  OTEL_EXPORTER_OTLP_TRACES_HEADERS \
  OTEL_EXPORTER_OTLP_TRACES_PROTOCOL \
  OTEL_RESOURCE_ATTRIBUTES \
  TRACEPARENT \
  TRACESTATE
do
  if [[ -n "${!name:-}" ]]; then
    export "TEST_RUNNER_${name}=${!name}"
  fi
done

run_id="${XCUITEST_RUN_ID:-${BUILDKITE_BUILD_ID:-local}-${BUILDKITE_JOB_ID:-$(date +%s)}}"
export "TEST_RUNNER_XCUITEST_RUN_ID=$run_id"

destination="${XCUITEST_DESTINATION:-}"
if [[ -z "$destination" ]]; then
  device_id="$({
    xcrun simctl list devices available \
      | sed -nE '/iPhone/s/^.*\(([[:xdigit:]-]{36})\).*$/\1/p'
  } | sed -n '1p')"

  if [[ -z "$device_id" ]]; then
    echo "No available iPhone Simulator found; set XCUITEST_DESTINATION" >&2
    exit 1
  fi

  destination="platform=iOS Simulator,id=$device_id"
fi

rm -rf "$result_bundle"
mkdir -p "$artifacts_dir"

xcodebuild \
  -project "$root/SwiftXCUITest.xcodeproj" \
  -scheme SwiftXCUITest \
  -resolvePackageDependencies 2>&1 | tee "$artifacts_dir/package-resolution.log"
cp "$root/SwiftXCUITest.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved" "$artifacts_dir/Package.resolved"

selection=(-only-testing:ExampleAppUITests/ExampleAppUITests -parallel-testing-enabled NO)
if [[ "${ARLO_SCENARIO:-restart}" == parallel ]]; then
  selection=(-only-testing:ExampleAppUITests/ParallelOne -only-testing:ExampleAppUITests/ParallelTwo -only-testing:ExampleAppUITests/ParallelThree
    -parallel-testing-enabled YES -parallel-testing-worker-count 3 -maximum-concurrent-test-simulator-destinations 3)
fi

set +e
xcodebuild \
  -project "$root/SwiftXCUITest.xcodeproj" \
  -scheme SwiftXCUITest \
  -testPlan SwiftXCUITest \
  -destination "$destination" \
  -derivedDataPath "$root/artifacts/DerivedData" \
  -resultBundlePath "$result_bundle" \
  "${selection[@]}" \
  test 2>&1 | tee "$test_log"
xcodebuild_status="${PIPESTATUS[0]}"
set -e

# Keep the independent Xcode inventory and timings, not just collector logs.
xcrun xcresulttool get test-results summary --path "$result_bundle" > "$artifacts_dir/summary.json"
xcrun xcresulttool get test-results tests --path "$result_bundle" > "$artifacts_dir/tests.json"

if [[ "${ARLO_SCENARIO:-restart}" == parallel ]]; then
  [[ "$xcodebuild_status" -eq 0 ]]
  [[ "$(plutil -extract passedTests raw -o - "$artifacts_dir/summary.json")" -eq 3 ]]
  exit 0
fi

verification_status=0
"$root/bin/verify-results" "$result_bundle" "$test_log" || verification_status="$?"

if [[ "$xcodebuild_status" -ne 0 ]]; then
  echo "xcodebuild exited $xcodebuild_status after the expected runner termination"
fi

exit "$verification_status"
