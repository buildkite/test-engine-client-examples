#!/bin/bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
artifacts_dir="${XCUITEST_ARTIFACTS_DIR:-$root/artifacts}"
result_bundle="$artifacts_dir/SwiftXCUITest.xcresult"

# bktec can assign an empty shard. Never turn that into an unfiltered run.
if [[ $# -eq 0 ]]; then
  echo 'No selectors assigned; running no tests.'
  exit 0
fi
only_testing=()
for selector in "$@"; do
  echo "Assigned selector: $selector"
  # Intersect assignments with discovery's enabled methods. Passing a class
  # straight to Xcode can override selectedTests in the customer's test plan.
  if ! methods="$(jq -r --arg selector "$selector" '
    [.values[].enabledTests[].identifier |
     select(. == $selector or startswith($selector + "/")) |
     select(split("/") | length == 3)] | unique[]' "$artifacts_dir/enumeration.json")"; then
    echo 'Cannot read enabled tests from enumeration.json; run bin/build and restore its artifacts.' >&2
    exit 1
  fi
  if [[ -z "$methods" ]]; then
    echo "Assigned selector '$selector' matches no enabled tests in enumeration.json." >&2
    exit 1
  fi
  while IFS= read -r method; do
    only_testing+=("-only-testing:$method")
  done <<< "$methods"
done

# XCTest needs only the loopback credential when bktec owns upstream uploads.
# Also remove a caller's pre-existing prefixed value rather than forwarding it.
if [[ -n "${BUILDKITE_TESTS_OTLP_TOKEN:-}" ]]; then
  unset TEST_RUNNER_BUILDKITE_ANALYTICS_TOKEN
fi

for name in \
  BUILDKITE_TEST_ENGINE_XCTEST_SPLIT_BY \
  BUILDKITE_ANALYTICS_BASE_URL \
  BUILDKITE_ANALYTICS_BRANCH \
  BUILDKITE_ANALYTICS_DEBUG_ENABLED \
  BUILDKITE_ANALYTICS_ENABLED \
  BUILDKITE_ANALYTICS_ENVIRONMENT \
  BUILDKITE_ANALYTICS_EXECUTION_NAME_PREFIX \
  BUILDKITE_ANALYTICS_EXECUTION_NAME_SUFFIX \
  BUILDKITE_ANALYTICS_JOB_ID \
  BUILDKITE_ANALYTICS_MESSAGE \
  BUILDKITE_ANALYTICS_NUMBER \
  BUILDKITE_ANALYTICS_OTLP_ENDPOINT \
  BUILDKITE_ANALYTICS_SHA \
  BUILDKITE_ANALYTICS_TAGS \
  BUILDKITE_ANALYTICS_TOKEN \
  BUILDKITE_ANALYTICS_URL \
  BUILDKITE_BRANCH \
  BUILDKITE_BUILD_ID \
  BUILDKITE_BUILD_NUMBER \
  BUILDKITE_BUILD_URL \
  BUILDKITE_COMMIT \
  BUILDKITE_JOB_ID \
  BUILDKITE_MESSAGE \
  BUILDKITE_TESTS_OTLP_TOKEN \
  OTEL_EXPORTER_OTLP_TRACES_ENDPOINT \
  OTEL_EXPORTER_OTLP_TRACES_HEADERS \
  OTEL_EXPORTER_OTLP_TRACES_PROTOCOL \
  OTEL_RESOURCE_ATTRIBUTES
do
  if [[ "$name" == BUILDKITE_ANALYTICS_TOKEN && -n "${BUILDKITE_TESTS_OTLP_TOKEN:-}" ]]; then
    continue
  fi
  if [[ -n "${!name:-}" ]]; then
    export "TEST_RUNNER_${name}=${!name}"
  fi
done

destination="${XCUITEST_DESTINATION:-platform=iOS Simulator,name=iPhone 17}"

rm -rf "$result_bundle"
mkdir -p "$artifacts_dir"

xcodebuild \
  test-without-building \
  -xctestrun "$artifacts_dir/Products/Tests.xctestrun" \
  -destination "$destination" \
  -resultBundlePath "$result_bundle" \
  -parallel-testing-enabled "${XCUITEST_PARALLEL_TESTING:-NO}" \
  -parallel-testing-worker-count 2 \
  "${only_testing[@]}"
