#!/bin/bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
artifacts_dir="${XCUITEST_ARTIFACTS_DIR:-$root/artifacts}"
result_bundle="$artifacts_dir/SwiftXCUITest.xcresult"

# bktec can assign an empty shard. Never turn that into an unfiltered run.
if [[ $# -eq 0 ]]; then
  echo 'No selectors assigned; running no tests.'
  exit 0
fi
only_testing=()
for selector in "$@"; do
  echo "Assigned selector: $selector"
  only_testing+=("-only-testing:$selector")
done

for name in \
  TEST_SPLIT_BY \
  BUILDKITE_ANALYTICS_BASE_URL \
  BUILDKITE_ANALYTICS_BRANCH \
  BUILDKITE_ANALYTICS_DEBUG_ENABLED \
  BUILDKITE_ANALYTICS_ENABLED \
  BUILDKITE_ANALYTICS_ENVIRONMENT \
  BUILDKITE_ANALYTICS_EXECUTION_NAME_PREFIX \
  BUILDKITE_ANALYTICS_EXECUTION_NAME_SUFFIX \
  BUILDKITE_ANALYTICS_JOB_ID \
  BUILDKITE_ANALYTICS_MESSAGE \
  BUILDKITE_ANALYTICS_NUMBER \
  BUILDKITE_ANALYTICS_OTLP_ENDPOINT \
  BUILDKITE_ANALYTICS_SHA \
  BUILDKITE_ANALYTICS_TAGS \
  BUILDKITE_ANALYTICS_TOKEN \
  BUILDKITE_ANALYTICS_URL \
  BUILDKITE_BRANCH \
  BUILDKITE_BUILD_ID \
  BUILDKITE_BUILD_NUMBER \
  BUILDKITE_BUILD_URL \
  BUILDKITE_COMMIT \
  BUILDKITE_JOB_ID \
  BUILDKITE_MESSAGE \
  BUILDKITE_TESTS_OTLP_TOKEN \
  OTEL_EXPORTER_OTLP_TRACES_ENDPOINT \
  OTEL_EXPORTER_OTLP_TRACES_HEADERS \
  OTEL_EXPORTER_OTLP_TRACES_PROTOCOL \
  OTEL_RESOURCE_ATTRIBUTES
do
  if [[ -n "${!name:-}" ]]; then
    export "TEST_RUNNER_${name}=${!name}"
  fi
done

destination="${XCUITEST_DESTINATION:-platform=iOS Simulator,name=iPhone 17}"

rm -rf "$result_bundle"
mkdir -p "$artifacts_dir"

xcodebuild \
  test-without-building \
  -testProductsPath "$artifacts_dir/Tests.xctestproducts" \
  -destination "$destination" \
  -resultBundlePath "$result_bundle" \
  -parallel-testing-enabled NO \
  "${only_testing[@]}"
