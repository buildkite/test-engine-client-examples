#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."
mkdir -p artifacts
destination="${XCUITEST_DESTINATION:-platform=iOS Simulator,name=iPhone 17}"
split_by="${BUILDKITE_TEST_ENGINE_XCTEST_SPLIT_BY:-class}"
case "$split_by" in class|method) ;; *) echo 'BUILDKITE_TEST_ENGINE_XCTEST_SPLIT_BY must be class or method' >&2; exit 1 ;; esac

# Temporary source pin until automatic selectors ship in the next collector
# release. Shards need only the built products, not this source checkout.
if [[ ! -d artifacts/collector-source/.git ]]; then
  git init -q artifacts/collector-source
fi
git -C artifacts/collector-source fetch -q --depth 1 https://github.com/buildkite/bktest.git 826afacd83cec95b93734cb443264b8150b1232b
git -C artifacts/collector-source checkout -q --detach FETCH_HEAD

# Keep Xcode's original products and xctestrun together. Both xcodebuild and
# fastlane scan can run this archive without resolving packages or rebuilding.
rm -rf artifacts/Products artifacts/enumeration.json
xcodebuild build-for-testing \
  -project SwiftXCUITest.xcodeproj -scheme SwiftXCUITest \
  -testPlan SwiftXCUITest -destination 'generic/platform=iOS Simulator' \
  -derivedDataPath artifacts/DerivedData
mv artifacts/DerivedData/Build/Products artifacts/Products
mv artifacts/Products/*.xctestrun artifacts/Products/Tests.xctestrun

# The collector knows the bundle name, whereas Xcode selects by target name.
# Reject custom product names instead of silently losing all timing matches.
plutil -convert json -o - artifacts/Products/Tests.xctestrun | jq -r '
  .TestConfigurations[].TestTargets[] |
  (.TestBundlePath | split("/")[-1] | rtrimstr(".xctest")) as $bundle |
  select(.BlueprintName != $bundle) |
  error("Test target \(.BlueprintName) builds bundle \($bundle). XCTest splitting requires PRODUCT_NAME to equal the target name; restore Xcode\u0027s default PRODUCT_NAME = $(TARGET_NAME).")'

xcodebuild test-without-building \
  -xctestrun artifacts/Products/Tests.xctestrun -destination "$destination" \
  -enumerate-tests -test-enumeration-style flat -test-enumeration-format json \
  -test-enumeration-output-path artifacts/enumeration.json

# Use Xcode's enabled identifiers, not source filenames or a maintained list.
jq -e '(.errors | length) == 0' artifacts/enumeration.json >/dev/null
jq -r --arg split "$split_by" '
  [.values[].enabledTests[].identifier | select(split("/") | length == 3) |
   if test("\\s") or (explode | any(. == 34 or . == 39 or . == 92)) then
     error("Unsupported XCTest identifier \(. | @json): bktec custom runner cannot preserve whitespace, quotes or backslashes in selectors. Rename the target/class/method before splitting.")
   else . end |
   if $split == "class" then split("/")[0:2] | join("/") else . end] |
  unique[]' artifacts/enumeration.json > artifacts/selectors.txt
test -s artifacts/selectors.txt
echo "Discovered $split_by selectors:"
cat artifacts/selectors.txt
# Keep the enabled method set: class-level -only-testing can override a
# test plan's selectedTests and otherwise re-enable excluded methods.
tar -czf artifacts/tests.tar.gz -C artifacts Products selectors.txt enumeration.json
